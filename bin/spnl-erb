#!/usr/bin/env ruby
# frozen_string_literal: true
require "optparse"
require_relative "../lib/spnl_erb"
opts = {attrs: [], method_name: "render", mode: :stateless}
batch = nil
output = nil
parser = OptionParser.new do |o|
  o.banner = "Usage: spnl-erb TEMPLATE [-c NAME] [--mode stateless|instance|controller]\n       spnl-erb --batch DIR [-c NAME --mode controller]"
  o.on("-c", "--class NAME") { |v| opts[:class_name] = v }
  o.on("-a", "--attrs LIST") { |v| opts[:attrs] = v.split(',') }
  o.on("-m", "--method NAME") { |v| opts[:method_name] = v }
  o.on("--mode MODE") { |v| opts[:mode] = v.to_sym }
  o.on("--target NAME") { |v| opts[:target_class] = v }
  o.on("-o", "--output FILE") { |v| output = v }
  o.on("--batch DIR") { |v| batch = v }
  o.on("-h", "--help") { puts o; exit }
end
begin
  parser.parse!
  if batch
    raise ArgumentError, "--output cannot be used with --batch" if output
    files = Dir.glob(File.join(batch, '**', '*.erb')).sort
    raise ArgumentError, "no templates under #{batch}" if files.empty?
    files.each do |path|
      template = File.read(path)
      rel = path.delete_prefix(batch.sub(%r{/$}, '') + '/')
      stem = rel.sub(/(?:\.html)?\.erb\z/, '')
      name = stem.split(/[\/_-]/).map(&:capitalize).join + 'View'
      args = opts.merge(class_name: opts[:class_name] || name, attrs: SpnlErb.attributes(template), source_path: path)
      args[:method_name] = 'render_' + stem.tr('/-', '__') if opts[:mode] == :controller
      File.write(path.sub(/\.erb\z/, '.generated.rb'), SpnlErb.compile_class(template, **args))
    end
  else
    raise ArgumentError, "expected one template" unless ARGV.length == 1
    path = ARGV.first
    template = File.read(path)
    result = if opts[:class_name] || opts[:mode] == :controller
      SpnlErb.compile_class(template, **opts.merge(class_name: opts[:class_name] || 'View', source_path: path))
    else
      SpnlErb.compile_body(template)
    end
    output ? File.write(output, result) : print(result)
  end
rescue ArgumentError, OptionParser::ParseError, Errno::ENOENT => e
  warn "spnl-erb: #{e.message}"
  exit 1
end
